{
  "id": "Process_reembolso_tobe",
  "name": "reembolso de gastos de viaje (to-be)",
  "pools": [
    {
      "id": "P_Nubia",
      "name": "Nubia SA",
      "lanes": [
        {
          "id": "L_emp",
          "name": "Empleado"
        },
        {
          "id": "L_sis",
          "name": "Sistema de gastos (BPMS)"
        },
        {
          "id": "L_jefe",
          "name": "Jefe inmediato"
        },
        {
          "id": "L_df",
          "name": "Director financiero"
        },
        {
          "id": "L_cxp",
          "name": "Cuentas por Pagar"
        }
      ],
      "nodes": [
        {
          "id": "S1",
          "type": "startEvent",
          "name": "Viaje concluido",
          "lane": "L_emp"
        },
        {
          "id": "M1",
          "type": "exclusiveGateway",
          "name": "",
          "lane": "L_emp"
        },
        {
          "id": "T20",
          "type": "userTask",
          "name": "Registrar gastos en portal",
          "lane": "L_emp",
          "doc": "Captura en origen: partidas + foto/CFDI de cada comprobante; validaciones en línea"
        },
        {
          "id": "T21",
          "type": "businessRuleTask",
          "name": "Validar informe contra política",
          "lane": "L_sis",
          "doc": "DMN 'Ruta del informe' + 'Tope por partida' (09-implementacion.md)"
        },
        {
          "id": "G1",
          "type": "exclusiveGateway",
          "name": "¿Informe válido?",
          "lane": "L_sis"
        },
        {
          "id": "G1b",
          "type": "exclusiveGateway",
          "name": "¿Requiere aprobación del jefe?",
          "lane": "L_sis"
        },
        {
          "id": "E2",
          "type": "endEvent",
          "name": "Informe rechazado por plazo",
          "lane": "L_sis"
        },
        {
          "id": "M5",
          "type": "exclusiveGateway",
          "name": "",
          "lane": "L_jefe"
        },
        {
          "id": "T03",
          "type": "userTask",
          "name": "Aprobar informe de gastos",
          "lane": "L_jefe",
          "doc": "Worklist/móvil; SLA 48 h hábiles"
        },
        {
          "id": "B1",
          "type": "boundaryEvent",
          "attachedTo": "T03",
          "event": "timer",
          "interrupting": true,
          "name": "48 h hábiles sin decisión",
          "lane": "L_jefe"
        },
        {
          "id": "T22",
          "type": "sendTask",
          "name": "Escalar aprobación al gerente",
          "lane": "L_sis",
          "doc": "Reasigna el work item al jefe del aprobador y notifica (patrón escalado)"
        },
        {
          "id": "G3",
          "type": "exclusiveGateway",
          "name": "¿Decisión del jefe?",
          "lane": "L_jefe"
        },
        {
          "id": "G3b",
          "type": "exclusiveGateway",
          "name": "¿Excede tope de política?",
          "lane": "L_sis"
        },
        {
          "id": "E3",
          "type": "endEvent",
          "name": "Informe rechazado por jefe",
          "lane": "L_jefe"
        },
        {
          "id": "T10",
          "type": "userTask",
          "name": "Decidir gasto excedente",
          "lane": "L_df",
          "doc": "Autoriza el excedente o lo limita al tope; el sistema aplica el monto"
        },
        {
          "id": "M2",
          "type": "exclusiveGateway",
          "name": "",
          "lane": "L_sis"
        },
        {
          "id": "T06",
          "type": "serviceTask",
          "name": "Contabilizar informe en ERP",
          "lane": "L_sis",
          "doc": "Integración REST con el ERP; crea el acreedor-empleado si no existe"
        },
        {
          "id": "G4",
          "type": "exclusiveGateway",
          "name": "¿Seleccionado para auditoría?",
          "lane": "L_sis"
        },
        {
          "id": "T23",
          "type": "userTask",
          "name": "Auditar informe por muestreo",
          "lane": "L_cxp",
          "doc": "Muestra aleatoria ~10 % + informes con excedente autorizado"
        },
        {
          "id": "M3",
          "type": "exclusiveGateway",
          "name": "",
          "lane": "L_sis"
        },
        {
          "id": "IE2",
          "type": "intermediateCatchEvent",
          "event": "timer",
          "name": "Corrida semanal alcanzada",
          "lane": "L_sis"
        },
        {
          "id": "T15",
          "type": "serviceTask",
          "name": "Pagar reembolsos en corrida",
          "lane": "L_sis",
          "doc": "Genera y envía el archivo de pagos; notifica al empleado"
        },
        {
          "id": "E1",
          "type": "endEvent",
          "name": "Reembolso pagado",
          "lane": "L_sis"
        }
      ],
