<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_e3252203" targetNamespace="http://bpmn.io/schema/bpmn" exporter="disenar-procesos bpmn_tool" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Process_reembolso_asis">
<bpmn:participant id="P_Nubia" name="Nubia SA" processRef="Proc_P_Nubia"/>
<bpmn:participant id="P_Banco" name="Banco"/>
<bpmn:messageFlow id="MsgFlow_1" name="Archivo de pagos" sourceRef="T15" targetRef="P_Banco"/>
<bpmn:textAnnotation id="A1"><bpmn:text>Política v2019: &lt; 1,000 MXN se aprueba sin revisión del jefe — no se aplica en la práctica (IN-02 vs IN-04)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A1_as" sourceRef="T03" targetRef="A1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Topes: hospedaje 1,800 MXN/noche; comidas 600 MXN/día (IN-03)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A2_as" sourceRef="T07" targetRef="A2"/>
</bpmn:collaboration>
<bpmn:process id="Proc_P_Nubia" name="reembolso de gastos de viaje (as-is)" isExecutable="false">
<bpmn:laneSet id="P_Nubia_ls">
<bpmn:lane id="L_emp" name="Empleado"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>M1</bpmn:flowNodeRef><bpmn:flowNodeRef>T01</bpmn:flowNodeRef><bpmn:flowNodeRef>T02</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_jefe" name="Jefe inmediato"><bpmn:flowNodeRef>IE1</bpmn:flowNodeRef><bpmn:flowNodeRef>T03</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>T04</bpmn:flowNodeRef><bpmn:flowNodeRef>T05</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_cxp" name="Cuentas por Pagar"><bpmn:flowNodeRef>T06</bpmn:flowNodeRef><bpmn:flowNodeRef>T07</bpmn:flowNodeRef><bpmn:flowNodeRef>G2</bpmn:flowNodeRef><bpmn:flowNodeRef>G2b</bpmn:flowNodeRef><bpmn:flowNodeRef>T08</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>T09</bpmn:flowNodeRef><bpmn:flowNodeRef>T11</bpmn:flowNodeRef><bpmn:flowNodeRef>M3</bpmn:flowNodeRef><bpmn:flowNodeRef>T12</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>T13</bpmn:flowNodeRef><bpmn:flowNodeRef>M4</bpmn:flowNodeRef><bpmn:flowNodeRef>IE2</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_df" name="Director financiero"><bpmn:flowNodeRef>T10</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_ti" name="TI"><bpmn:flowNodeRef>T14</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Viaje concluido"><bpmn:outgoing>Flow_P_Nubia_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="M1" name=""><bpmn:incoming>Flow_P_Nubia_1</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_9</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_18</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:manualTask id="T01" name="Preparar informe de gastos"><bpmn:documentation>Llena el formato Excel y escanea los tickets (IN-01)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_2</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_3</bpmn:outgoing><bpmn:dataOutputAssociation id="T01_D1_out"><bpmn:targetRef>D1_ref</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="T01_D2_out"><bpmn:targetRef>D2_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:manualTask>
<bpmn:sendTask id="T02" name="Enviar informe al jefe"><bpmn:documentation>Por correo electrónico (IN-01)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_3</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_4</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="IE1" name="Viernes de revisión alcanzado"><bpmn:documentation>Revisión en bloque los viernes (IN-02)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_4</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_5</bpmn:outgoing><bpmn:timerEventDefinition id="IE1_ed"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="T03" name="Revisar informe de gastos"><bpmn:documentation>Montos razonables y tickets presentes (IN-02)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_5</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_6</bpmn:outgoing><bpmn:dataInputAssociation id="T03_D1_in"><bpmn:sourceRef>D1_ref</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="T03_D2_in"><bpmn:sourceRef>D2_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="G1" name="¿Informe completo y razonable?"><bpmn:incoming>Flow_P_Nubia_6</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_7</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T04" name="Devolver informe con observaciones"><bpmn:documentation>Falta de ticket u otra observación (IN-01)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_7</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_9</bpmn:outgoing></bpmn:sendTask>
<bpmn:sendTask id="T05" name="Aprobar informe por correo"><bpmn:documentation>Responde el correo y lo reenvía a CxP (IN-02)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_8</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_10</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="T06" name="Capturar informe en ERP"><bpmn:documentation>10 min por informe (IN-03)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_10</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_11</bpmn:outgoing><bpmn:dataOutputAssociation id="T06_D3_out"><bpmn:targetRef>D3_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:userTask id="T07" name="Verificar política de gastos"><bpmn:documentation>Completitud, plazo 30 días, topes hospedaje 1,800/noche y comidas 600/día (IN-03, IN-04)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_11</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_12</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G2" name="¿Informe completo y en plazo?"><bpmn:incoming>Flow_P_Nubia_12</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_13</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_14</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G2b" name="¿Excede tope de política?"><bpmn:incoming>Flow_P_Nubia_15</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_16</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T08" name="Devolver informe incompleto"><bpmn:documentation>~15 % de los informes (IN-03)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_13</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_18</bpmn:outgoing></bpmn:sendTask>
<bpmn:endEvent id="E2" name="Informe rechazado por plazo"><bpmn:incoming>Flow_P_Nubia_14</bpmn:incoming></bpmn:endEvent>
<bpmn:sendTask id="T09" name="Solicitar autorización de excedente"><bpmn:incoming>Flow_P_Nubia_16</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_19</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="T10" name="Decidir gasto excedente"><bpmn:incoming>Flow_P_Nubia_19</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_20</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G3" name="¿Excedente autorizado?"><bpmn:incoming>Flow_P_Nubia_20</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_21</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T11" name="Ajustar monto al tope"><bpmn:documentation>[SUPUESTO] si el DF no autoriza, se reembolsa hasta el tope</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_22</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_23</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="M3" name=""><bpmn:incoming>Flow_P_Nubia_17</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_21</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_23</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T12" name="Verificar cuenta de proveedor"><bpmn:incoming>Flow_P_Nubia_24</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_25</bpmn:outgoing><bpmn:dataInputAssociation id="T12_D3_in"><bpmn:sourceRef>D3_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="G4" name="¿Empleado tiene cuenta de proveedor?"><bpmn:incoming>Flow_P_Nubia_25</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_26</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_27</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="T13" name="Solicitar alta de proveedor"><bpmn:incoming>Flow_P_Nubia_27</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_28</bpmn:outgoing></bpmn:sendTask>
<bpmn:userTask id="T14" name="Dar de alta proveedor"><bpmn:documentation>Tarda ~2 días (IN-03)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_28</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_29</bpmn:outgoing><bpmn:dataOutputAssociation id="T14_D3_out"><bpmn:targetRef>D3_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="M4" name=""><bpmn:incoming>Flow_P_Nubia_26</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_29</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_30</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="IE2" name="Corrida quincenal alcanzada"><bpmn:documentation>Pagos en corrida quincenal (IN-03)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_30</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_31</bpmn:outgoing><bpmn:timerEventDefinition id="IE2_ed"/></bpmn:intermediateCatchEvent>
<bpmn:userTask id="T15" name="Pagar reembolsos en corrida"><bpmn:incoming>Flow_P_Nubia_31</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_32</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E1" name="Reembolso pagado"><bpmn:incoming>Flow_P_Nubia_32</bpmn:incoming></bpmn:endEvent>
