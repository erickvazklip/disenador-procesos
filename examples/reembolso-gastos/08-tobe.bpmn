<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_f1fbbece" targetNamespace="http://bpmn.io/schema/bpmn" exporter="disenar-procesos bpmn_tool" exporterVersion="1.0">
<bpmn:collaboration id="Collab_Process_reembolso_tobe">
<bpmn:participant id="P_Nubia" name="Nubia SA" processRef="Proc_P_Nubia"/>
<bpmn:participant id="P_Banco" name="Banco"/>
<bpmn:messageFlow id="MsgFlow_1" name="Archivo de pagos" sourceRef="T15" targetRef="P_Banco"/>
<bpmn:textAnnotation id="A1"><bpmn:text>DMN: ruta = INCOMPLETO | FUERA_DE_PLAZO | AUTO | JEFE (hit U, completa C)</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A1_as" sourceRef="T21" targetRef="A1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Rechazo por plazo solo si &gt; 30 días (política v2019) [A VALIDAR vigencia]</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="A2_as" sourceRef="E2" targetRef="A2"/>
</bpmn:collaboration>
<bpmn:process id="Proc_P_Nubia" name="reembolso de gastos de viaje (to-be)" isExecutable="false">
<bpmn:laneSet id="P_Nubia_ls">
<bpmn:lane id="L_emp" name="Empleado"><bpmn:flowNodeRef>S1</bpmn:flowNodeRef><bpmn:flowNodeRef>M1</bpmn:flowNodeRef><bpmn:flowNodeRef>T20</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_sis" name="Sistema de gastos (BPMS)"><bpmn:flowNodeRef>T21</bpmn:flowNodeRef><bpmn:flowNodeRef>G1</bpmn:flowNodeRef><bpmn:flowNodeRef>G1b</bpmn:flowNodeRef><bpmn:flowNodeRef>E2</bpmn:flowNodeRef><bpmn:flowNodeRef>T22</bpmn:flowNodeRef><bpmn:flowNodeRef>G3b</bpmn:flowNodeRef><bpmn:flowNodeRef>M2</bpmn:flowNodeRef><bpmn:flowNodeRef>T06</bpmn:flowNodeRef><bpmn:flowNodeRef>G4</bpmn:flowNodeRef><bpmn:flowNodeRef>M3</bpmn:flowNodeRef><bpmn:flowNodeRef>IE2</bpmn:flowNodeRef><bpmn:flowNodeRef>T15</bpmn:flowNodeRef><bpmn:flowNodeRef>E1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_jefe" name="Jefe inmediato"><bpmn:flowNodeRef>M5</bpmn:flowNodeRef><bpmn:flowNodeRef>T03</bpmn:flowNodeRef><bpmn:flowNodeRef>B1</bpmn:flowNodeRef><bpmn:flowNodeRef>G3</bpmn:flowNodeRef><bpmn:flowNodeRef>E3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_df" name="Director financiero"><bpmn:flowNodeRef>T10</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_cxp" name="Cuentas por Pagar"><bpmn:flowNodeRef>T23</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="S1" name="Viaje concluido"><bpmn:outgoing>Flow_P_Nubia_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="M1" name=""><bpmn:incoming>Flow_P_Nubia_1</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_5</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_14</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_2</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T20" name="Registrar gastos en portal"><bpmn:documentation>Captura en origen: partidas + foto/CFDI de cada comprobante; validaciones en línea</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_2</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_3</bpmn:outgoing><bpmn:dataOutputAssociation id="T20_D1_out"><bpmn:targetRef>D1_ref</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataOutputAssociation id="T20_D2_out"><bpmn:targetRef>D2_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
<bpmn:businessRuleTask id="T21" name="Validar informe contra política"><bpmn:documentation>DMN &#x27;Ruta del informe&#x27; + &#x27;Tope por partida&#x27; (09-implementacion.md)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_3</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_4</bpmn:outgoing><bpmn:dataInputAssociation id="T21_D1_in"><bpmn:sourceRef>D1_ref</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataInputAssociation id="T21_D2_in"><bpmn:sourceRef>D2_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G1" name="¿Informe válido?"><bpmn:incoming>Flow_P_Nubia_4</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_5</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_6</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G1b" name="¿Requiere aprobación del jefe?"><bpmn:incoming>Flow_P_Nubia_7</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_8</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E2" name="Informe rechazado por plazo"><bpmn:incoming>Flow_P_Nubia_6</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="M5" name=""><bpmn:incoming>Flow_P_Nubia_9</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_12</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T03" name="Aprobar informe de gastos"><bpmn:documentation>Worklist/móvil; SLA 48 h hábiles</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_10</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_13</bpmn:outgoing><bpmn:dataInputAssociation id="T03_D1_in"><bpmn:sourceRef>D1_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:boundaryEvent id="B1" name="48 h hábiles sin decisión" attachedToRef="T03" cancelActivity="true"><bpmn:outgoing>Flow_P_Nubia_11</bpmn:outgoing><bpmn:timerEventDefinition id="B1_ed"/></bpmn:boundaryEvent>
<bpmn:sendTask id="T22" name="Escalar aprobación al gerente"><bpmn:documentation>Reasigna el work item al jefe del aprobador y notifica (patrón escalado)</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_11</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_12</bpmn:outgoing></bpmn:sendTask>
<bpmn:exclusiveGateway id="G3" name="¿Decisión del jefe?"><bpmn:incoming>Flow_P_Nubia_13</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_14</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_15</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="G3b" name="¿Excede tope de política?"><bpmn:incoming>Flow_P_Nubia_16</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_17</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E3" name="Informe rechazado por jefe"><bpmn:incoming>Flow_P_Nubia_15</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T10" name="Decidir gasto excedente"><bpmn:documentation>Autoriza el excedente o lo limita al tope; el sistema aplica el monto</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_18</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_19</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="M2" name=""><bpmn:incoming>Flow_P_Nubia_8</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_17</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_19</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T06" name="Contabilizar informe en ERP"><bpmn:documentation>Integración REST con el ERP; crea el acreedor-empleado si no existe</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_20</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_21</bpmn:outgoing><bpmn:dataOutputAssociation id="T06_D3_out"><bpmn:targetRef>D3_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G4" name="¿Seleccionado para auditoría?"><bpmn:incoming>Flow_P_Nubia_21</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_22</bpmn:outgoing><bpmn:outgoing>Flow_P_Nubia_23</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T23" name="Auditar informe por muestreo"><bpmn:documentation>Muestra aleatoria ~10 % + informes con excedente autorizado</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_22</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_24</bpmn:outgoing><bpmn:dataInputAssociation id="T23_D2_in"><bpmn:sourceRef>D2_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="M3" name=""><bpmn:incoming>Flow_P_Nubia_23</bpmn:incoming><bpmn:incoming>Flow_P_Nubia_24</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:intermediateCatchEvent id="IE2" name="Corrida semanal alcanzada"><bpmn:incoming>Flow_P_Nubia_25</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_26</bpmn:outgoing><bpmn:timerEventDefinition id="IE2_ed"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="T15" name="Pagar reembolsos en corrida"><bpmn:documentation>Genera y envía el archivo de pagos; notifica al empleado</bpmn:documentation><bpmn:incoming>Flow_P_Nubia_26</bpmn:incoming><bpmn:outgoing>Flow_P_Nubia_27</bpmn:outgoing><bpmn:dataInputAssociation id="T15_D3_in"><bpmn:sourceRef>D3_ref</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="E1" name="Reembolso pagado"><bpmn:incoming>Flow_P_Nubia_27</bpmn:incoming></bpmn:endEvent>
